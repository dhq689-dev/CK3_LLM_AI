{
  "_comment": "Translation table for the CK3 injection layer. These are DATA, not code, so a mod/version change is an edit here. Effect/trigger/modifier names are PROVISIONAL: replace them with a script_docs dump for the target game version (risk register #10, docs/roadmap.md M17). Strings are string.Template templates (placeholders: $ref, $id, $target, $ratio).",
  "aggression_tiers": {
    "prefix": "ck3llm_aggressive_",
    "count": 5,
    "thresholds": [2, 4, 6, 8],
    "years": 5
  },
  "default_modifier_years": 5,
  "hard_action_limit": 2,
  "character_ref_prefix": "char:",
  "scopes": {
    "title": "title:$ref.holder",
    "character": "character:$id"
  },
  "actions": {
    "war": {
      "effect": "start_war",
      "target_param": "target",
      "min_power_ratio": 1.0,
      "guards": [
        "exists = $target",
        "NOT = { has_truce_with = { target = $target } }",
        "NOT = { is_at_war_with = { target = $target } }",
        "power_ratio_at_least = { target = $target ratio = $ratio }"
      ]
    },
    "alliance": {
      "effect": "create_alliance",
      "target_param": "target",
      "guards": [
        "exists = $target",
        "NOT = { has_alliance_with = { target = $target } }"
      ]
    },
    "peace": {
      "effect": "end_war",
      "target_param": "target",
      "guards": [
        "exists = $target",
        "is_at_war_with = { target = $target }"
      ]
    }
  }
}
